#!/bin/sh
# CarotOS-AUL: IceWM oturum baslangic betigi (icewm-session calistirir).
# Felsefe: bos masaustunde yalnizca gerekenler calisir, gerisi istek uzerine baslar.
#  - dunst (bildirim): burada BASLATILMAZ; ilk bildirimde D-Bus kendiliginden baslatir.
#  - lxpolkit (yetki ajani): burada BASLATILMAZ; /usr/local/bin/pkexec ilk ihtiyacta baslatir.
#  - USB izleme: oturumla birlikte calisir.

# Ekran bilgisini D-Bus/systemd kullanici yoneticisine ver (istek uzerine baslayan dunst DISPLAY'i bulsun).
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY >/dev/null 2>&1

if [ -x /opt/carotos/usb/carotos-usb-check.py ]; then
	/opt/carotos/usb/carotos-usb-check.py --monitor >/dev/null 2>&1 &
fi

# Karsilama Sihirbazi: ilk oturumlarda acilir; "Bitir" ya da "bir daha gosterme" ile kapanir.
# Menuden (CarotOS > Welcome Wizard) her zaman elle acilabilir.
if [ -x /opt/carotos/welcome/carotos-welcome.py ]; then
	/opt/carotos/welcome/carotos-welcome.py --autostart >/dev/null 2>&1 &
fi
